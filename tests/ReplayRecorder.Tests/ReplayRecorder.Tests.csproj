<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Own folder: the shared build folder holds the app's self-contained runtime files, which break testhost. -->
    <OutputPath>$(MSBuildThisFileDirectory)bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ReplayRecorder.Core\ReplayRecorder.Core.csproj" />
    <!-- The recorder is a self-contained Windows app, so its pure parts are compiled in here instead of referenced. -->
    <Compile Include="..\..\src\ReplayRecorder.Recorder\Audio\PcmConverter.cs" Link="Recorder\PcmConverter.cs" />
    <Compile Include="..\..\src\ReplayRecorder.Recorder\TsPacket.cs" Link="Recorder\TsPacket.cs" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
