<Window x:Class="ReplayRecorder.Library.SettingsUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:ReplayRecorder.Library.SettingsUi"
        Title="Replay Recorder Settings" Width="1040" Height="860" MinWidth="820" MinHeight="500"
        Background="{DynamicResource Bg}" WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,10"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Subtle}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="Group" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SettingsGroupBg}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="{DynamicResource SettingsGroupPad}"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="{DynamicResource SettingsRowPad}"/>
        </Style>
        <!-- The faint line under each row (Aurora; transparent in Classic) -->
        <Style x:Key="RowLine" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsRowLine}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <!-- Small heading inside a page ("GAME AND CHAT"); upper-cased in code after translating -->
        <Style x:Key="SubHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
            <Setter Property="Margin" Value="0,24,0,2"/>
        </Style>
        <!-- Page list: icon in the accent and label in full white on the chosen page -->
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Subtle}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="14,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Subtle}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Accent colour circle: Background is the colour, Tag the saved value -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="accent"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="ring" Stroke="{DynamicResource Text}" StrokeThickness="0"/>
                            <Ellipse Margin="4" Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="StrokeThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ring" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- Own title bar, as in the main window: the top 58 px drag the window -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="58" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Faint accent light from the top edge, grain against banding (as in the main window) -->
        <Rectangle Grid.RowSpan="2" Fill="{DynamicResource AccentGlow}" IsHitTestVisible="False"/>
        <Rectangle Grid.RowSpan="2" Fill="{DynamicResource Grain}" Opacity="{DynamicResource GrainOpacity}"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
                <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.71" RadiusY="0.6">
                    <GradientStop Color="Black" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.OpacityMask>
        </Rectangle>
        <TextBlock Text="Settings" FontFamily="{DynamicResource DisplayFont}" FontSize="15.5" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="30,0,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13,6,0">
            <Button Style="{StaticResource CaptionBtn}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"/>
            <Button x:Name="MaxBtn" Style="{StaticResource CaptionBtn}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize"/>
            <Button Style="{StaticResource CloseBtn}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
        </StackPanel>

    <Grid Grid.Row="1" Margin="8,0,8,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Section menu: each entry is its own page -->
        <Border CornerRadius="{DynamicResource PanelRadius}" Background="{DynamicResource PanelBg}" Padding="10,6,8,8">
            <DockPanel>
                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" SelectionChanged="NavList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="{DynamicResource Subtle}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" CornerRadius="{DynamicResource NavRadius}" Padding="14,10" Margin="0,1" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Glass}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Glass2}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                        <ListBoxItem Tag="SecReplay">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="Instant replay" Style="{StaticResource NavText}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="SecVideo">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE714;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="Video" Style="{StaticResource NavText}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="SecAudio">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE767;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="Audio" Style="{StaticResource NavText}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="SecFolders">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="Folders and storage" Style="{StaticResource NavText}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="SecDiscord">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE898;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="Discord export" Style="{StaticResource NavText}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="SecGeneral">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="General" Style="{StaticResource NavText}"/>
                            </StackPanel>
                        </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content panel: the chosen page, Save/Cancel stay at the bottom -->
        <Border Grid.Column="2" CornerRadius="{DynamicResource PanelRadius}" Background="{DynamicResource PanelBg}">
        <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="28,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource GhostBtn}" Margin="0,0,8,0" Padding="18,8"/>
                    <Button Content="Save" Click="Save_Click" Style="{StaticResource AccentBtn}" Padding="26,8"/>
                </StackPanel>
                <TextBlock x:Name="FooterText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0"
                           Text="Saving restarts the recorder's capture (about a second)."/>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="28,0,20,28">
            <!-- Pages always 760 px wide (less when the window is narrower), left-aligned -->
            <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="760"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="Pages">
                <!-- ============ Replay & hotkeys ============ -->
                <TextBlock x:Name="SecReplay" Text="Instant replay" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Replay length" Style="{StaticResource Label}"/>
                            <Slider x:Name="BufferSlider" Grid.Column="1" Minimum="15" Maximum="300" SmallChange="5" LargeChange="15" ValueChanged="BufferSlider_ValueChanged"/>
                            <TextBlock x:Name="BufferText" Grid.Column="2" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Save clip hotkey" Style="{StaticResource Label}"/>
                            <s:HotkeyBox x:Name="SaveHotkey" Grid.Column="1"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Start/stop full recording" Style="{StaticResource Label}"/>
                                <TextBlock Text="Optional" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <s:HotkeyBox x:Name="RecordHotkey" Grid.Column="1" AllowEmpty="True"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Keep the replay buffer in RAM" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="RamHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,12,0"/>
                            </StackPanel>
                            <CheckBox x:Name="RamBox" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top"/>
                        </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="Avoid Alt+F10 / Alt+F9 / Alt+Z: the NVIDIA overlay uses them. Either Alt key works for Alt hotkeys."/>
                    </StackPanel>
                </Border>

                <!-- ============ Video ============ -->
                <TextBlock x:Name="SecVideo" Text="Video" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Monitor to record" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="MonitorBox" Grid.Column="1" SelectionChanged="MonitorBox_SelectionChanged"/>
                        </Grid>
                        </Border>
                        <TextBlock x:Name="MonitorWarning" Style="{StaticResource Hint}" Foreground="{DynamicResource Warn}" Visibility="Collapsed" Margin="230,-4,0,6"/>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Resolution" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="ResolutionBox" Grid.Column="1"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Frame rate" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="FpsBox" Grid.Column="1"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Quality" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="QualityBox" Grid.Column="1"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Encoder" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="EncoderBox" Grid.Column="1"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Codec" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="CodecBox" Grid.Column="1"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Capture method" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="CaptureBox" Grid.Column="1"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Record mouse cursor" Style="{StaticResource Label}"/>
                            <CheckBox x:Name="CursorBox" Grid.Column="1" Style="{StaticResource Switch}"/>
                        </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ Audio ============ -->
                <TextBlock x:Name="SecAudio" Text="Audio" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <TextBlock x:Name="SubGame" Text="Game and chat" Style="{StaticResource SubHead}" Margin="0,4,0,2"/>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Game + voice chat" Style="{StaticResource Label}"/>
                                <TextBlock Text="Everything you hear, Discord included" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <CheckBox x:Name="SysEnabled" Grid.Column="1" Style="{StaticResource Switch}" Content="Record"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Output device" Style="{StaticResource Label}"/>
                                <TextBlock Text="Not used while Discord has its own track" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,12,0"/>
                            </StackPanel>
                            <ComboBox x:Name="SysDeviceBox" Grid.Column="1" SelectionChanged="SysDeviceBox_SelectionChanged"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Game volume" Style="{StaticResource Label}"/>
                            <Slider x:Name="SysVol" Grid.Column="1" Foreground="{DynamicResource GameTrack}" Minimum="-30" Maximum="20" SmallChange="1" LargeChange="3" ValueChanged="Vol_ValueChanged"/>
                            <TextBlock x:Name="SysVolText" Grid.Column="2" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Level" Style="{StaticResource Label}" Foreground="{DynamicResource Subtle}"/>
                            <Border Grid.Column="1" Height="8" CornerRadius="4" Background="{DynamicResource Line}" ClipToBounds="True">
                                <Border x:Name="SysMeter" HorizontalAlignment="Left" Width="0" CornerRadius="4" Background="{DynamicResource Good}"/>
                            </Border>
                            <TextBlock x:Name="SysMeterText" Grid.Column="2" Style="{StaticResource Hint}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Discord on its own track" Style="{StaticResource Label}"/>
                                <TextBlock Text="Friends' voices apart from the game, so you can rebalance them later" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,12,0"/>
                            </StackPanel>
                            <CheckBox x:Name="DiscordSeparate" Grid.Column="1" Style="{StaticResource Switch}" Content="Separate"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Discord volume" Style="{StaticResource Label}"/>
                            <Slider x:Name="DiscordVol" Grid.Column="1" Foreground="{DynamicResource DiscordTrack}" Minimum="-30" Maximum="20" SmallChange="1" LargeChange="3" ValueChanged="Vol_ValueChanged"/>
                            <TextBlock x:Name="DiscordVolText" Grid.Column="2" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                        </Grid>
                        </Border>

                        <TextBlock x:Name="SubMic" Text="Microphone" Style="{StaticResource SubHead}"/>

                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Microphone" Style="{StaticResource Label}"/>
                                <TextBlock Text="Its own track, so you can rebalance it later" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <CheckBox x:Name="MicEnabled" Grid.Column="1" Style="{StaticResource Switch}" Content="Record"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Mic device" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="MicDeviceBox" Grid.Column="1" SelectionChanged="MicDeviceBox_SelectionChanged"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Mic boost" Style="{StaticResource Label}"/>
                            <Slider x:Name="MicVol" Grid.Column="1" Minimum="-30" Maximum="20" SmallChange="1" LargeChange="3" ValueChanged="Vol_ValueChanged"/>
                            <TextBlock x:Name="MicVolText" Grid.Column="2" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Mic leveling" Style="{StaticResource Label}"/>
                                <TextBlock Text="Evens out quiet talk and shouting" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <ComboBox x:Name="MicLevelingBox" Grid.Column="1" Width="120" HorizontalAlignment="Left"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Level (with boost)" Style="{StaticResource Label}" Foreground="{DynamicResource Subtle}"/>
                                <TextBlock Text="Talk normally: aim for the bar to reach the middle" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Height="8" CornerRadius="4" Background="{DynamicResource Line}" ClipToBounds="True" VerticalAlignment="Center">
                                <Border x:Name="MicMeter" HorizontalAlignment="Left" Width="0" CornerRadius="4" Background="{DynamicResource Good}"/>
                            </Border>
                            <TextBlock x:Name="MicMeterText" Grid.Column="2" Style="{StaticResource Hint}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"/>
                        </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ Folders & storage ============ -->
                <TextBlock x:Name="SecFolders" Text="Folders and storage" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Clips folder" Style="{StaticResource Label}"/>
                            <TextBox x:Name="ClipsFolderBox" Grid.Column="1" Style="{StaticResource Field}"/>
                            <Button Grid.Column="2" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click" Tag="ClipsFolderBox"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Discord exports folder" Style="{StaticResource Label}"/>
                            <TextBox x:Name="ExportFolderBox" Grid.Column="1" Style="{StaticResource Field}"/>
                            <Button Grid.Column="2" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click" Tag="ExportFolderBox"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Replay buffer folder" Style="{StaticResource Label}"/>
                                <TextBlock Text="Rolling temp files (~300 MB). An SSD is best." Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <TextBox x:Name="BufferFolderBox" Grid.Column="1" Style="{StaticResource Field}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click" Tag="BufferFolderBox" VerticalAlignment="Center"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Warn when clips exceed" Style="{StaticResource Label}"/>
                                <TextBlock Text="GB · 0 = never warn" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <TextBox x:Name="LimitBox" Grid.Column="1" Style="{StaticResource Field}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="UsageText" Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Delete clips older than" Style="{StaticResource Label}"/>
                                <TextBlock Text="days · deleted for good, favorites are kept" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,12,0"/>
                            </StackPanel>
                            <TextBox x:Name="AutoDeleteDaysBox" Grid.Column="1" Style="{StaticResource Field}" VerticalAlignment="Center"
                                     IsEnabled="{Binding IsChecked, ElementName=AutoDeleteBox}"/>
                            <CheckBox x:Name="AutoDeleteBox" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ Discord export ============ -->
                <TextBlock x:Name="SecDiscord" Text="Discord export" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource Group}">
                    <Border Style="{StaticResource RowLine}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Maximum file size" Style="{StaticResource Label}"/>
                            <TextBlock Text="MB · Discord free limit is 20" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <TextBox x:Name="TargetBox" Grid.Column="1" Style="{StaticResource Field}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Text="Nitro: up to 500. Exports are never larger than this."/>
                    </Grid>
                    </Border>
                </Border>

                <!-- ============ General ============ -->
                <TextBlock x:Name="SecGeneral" Text="General" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource Group}">
                    <StackPanel>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Look" Style="{StaticResource Label}"/>
                                <TextBlock Text="Changes right away; Save keeps it" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <ComboBox x:Name="ThemeBox" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Language" Style="{StaticResource Label}"/>
                                <TextBlock Text="Applies when you save" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <ComboBox x:Name="LanguageBox" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Accent colour" Style="{StaticResource Label}"/>
                                <TextBlock Text="Buttons, selection and the trim bar" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <WrapPanel x:Name="AccentSwatches" Grid.Column="1" VerticalAlignment="Center">
                                <RadioButton Style="{StaticResource Swatch}" Tag="" Background="{DynamicResource Card}" ToolTip="Auto: the look's own colour" Checked="Swatch_Checked">
                                    <TextBlock Text="A" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Subtle}"/>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Swatch}" Tag="#4CC2FF" Background="#4CC2FF" ToolTip="Blue" Checked="Swatch_Checked"/>
                                <RadioButton Style="{StaticResource Swatch}" Tag="#8B7CFF" Background="#8B7CFF" ToolTip="Violet" Checked="Swatch_Checked"/>
                                <RadioButton Style="{StaticResource Swatch}" Tag="#FF6BD5" Background="#FF6BD5" ToolTip="Pink" Checked="Swatch_Checked"/>
                                <RadioButton Style="{StaticResource Swatch}" Tag="#FF5A5F" Background="#FF5A5F" ToolTip="Red" Checked="Swatch_Checked"/>
                                <RadioButton Style="{StaticResource Swatch}" Tag="#FF9F43" Background="#FF9F43" ToolTip="Orange" Checked="Swatch_Checked"/>
                                <RadioButton Style="{StaticResource Swatch}" Tag="#FFB627" Background="#FFB627" ToolTip="Amber" Checked="Swatch_Checked"/>
                                <RadioButton Style="{StaticResource Swatch}" Tag="#3DDC84" Background="#3DDC84" ToolTip="Green" Checked="Swatch_Checked"/>
                                <RadioButton Style="{StaticResource Swatch}" Tag="#2ED3E6" Background="#2ED3E6" ToolTip="Cyan" Checked="Swatch_Checked"/>
                                <Button Content="Custom…" Padding="12,6" Margin="4,0,0,6" Click="CustomAccent_Click" ToolTip="Pick any colour"/>
                            </WrapPanel>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Start recorder with Windows" Style="{StaticResource Label}"/>
                            <CheckBox x:Name="StartupBox" Grid.Column="1" Style="{StaticResource Switch}"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="&quot;Clip saved&quot; pop-ups" Style="{StaticResource Label}"/>
                            <CheckBox x:Name="NotifyBox" Grid.Column="1" Style="{StaticResource Switch}"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Sound when a clip is saved" Style="{StaticResource Label}"/>
                                <TextBlock Text="Pop-ups can't show over exclusive-fullscreen games" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <CheckBox x:Name="SoundBox" Grid.Column="1" Style="{StaticResource Switch}"/>
                        </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Game names" Style="{StaticResource Label}"/>
                                <TextBlock Text="One per line: game.exe = Folder name. Unknown games use the window's product name." Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <TextBox x:Name="GamesBox" Grid.Column="1" Style="{StaticResource Field}" AcceptsReturn="True" Height="150"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                        </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
            </Grid>
        </ScrollViewer>
        </DockPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
