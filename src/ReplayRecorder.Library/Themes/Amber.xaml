<!-- "Amber": graphite blue with broadcast amber; Bahnschrift (ships with Windows) for titles and times. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#0D0F13"/>
    <SolidColorBrush x:Key="Panel" Color="#181B22"/>
    <SolidColorBrush x:Key="Card" Color="#22262F"/>
    <SolidColorBrush x:Key="CardHover" Color="#2A2F3A"/>
    <SolidColorBrush x:Key="Line" Color="#323746"/>
    <SolidColorBrush x:Key="Text" Color="#EEF0F4"/>
    <SolidColorBrush x:Key="Subtle" Color="#9097A6"/>
    <SolidColorBrush x:Key="Accent" Color="#FFB627"/>
    <SolidColorBrush x:Key="OnAccent" Color="#1A1300"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#2EFFB627"/>
    <SolidColorBrush x:Key="Danger" Color="#F0605A"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#3D4352"/>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="NumFont">Bahnschrift, Segoe UI</FontFamily>
</ResourceDictionary>
