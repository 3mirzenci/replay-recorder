<!-- "Amber": graphite blue with broadcast amber; Bahnschrift (ships with Windows) for titles and times. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <SolidColorBrush x:Key="Bg" Color="#0D0F13"/>
    <SolidColorBrush x:Key="Panel" Color="#181B22"/>
    <SolidColorBrush x:Key="Card" Color="#22262F"/>
    <SolidColorBrush x:Key="CardHover" Color="#2A2F3A"/>
    <SolidColorBrush x:Key="Line" Color="#323746"/>
    <SolidColorBrush x:Key="Text" Color="#EEF0F4"/>
    <SolidColorBrush x:Key="Subtle" Color="#9097A6"/>
    <SolidColorBrush x:Key="Accent" Color="#FFB627"/>
    <SolidColorBrush x:Key="OnAccent" Color="#1A1300"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#2EFFB627"/>
    <SolidColorBrush x:Key="Danger" Color="#F0605A"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#3D4352"/>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="NumFont">Bahnschrift, Segoe UI</FontFamily>
    <!-- Keys added for Aurora, here with Classic values: boxes stay, no glow -->
    <SolidColorBrush x:Key="Raised" Color="#181B22"/>
    <SolidColorBrush x:Key="Glass" Color="#22262F"/>
    <SolidColorBrush x:Key="Glass2" Color="#2A2F3A"/>
    <SolidColorBrush x:Key="Edge" Color="#323746"/>
    <SolidColorBrush x:Key="Faint" Color="#9097A6"/>
    <SolidColorBrush x:Key="GameTrack" Color="#9097A6"/>
    <SolidColorBrush x:Key="DiscordTrack" Color="#5865F2"/>
    <SolidColorBrush x:Key="Good" Color="#2ECC71"/>
    <SolidColorBrush x:Key="Warn" Color="#E5A84B"/>
    <SolidColorBrush x:Key="Bad" Color="#E5534B"/>
    <SolidColorBrush x:Key="Star" Color="#FFC83D"/>
    <SolidColorBrush x:Key="Tick" Color="#6B6F7A"/>
    <!-- Fullscreen bar over the video: the same in every look -->
    <SolidColorBrush x:Key="Overlay" Color="#960C0C10"/>
    <SolidColorBrush x:Key="OverlaySubtle" Color="#BEBEC8"/>
    <SolidColorBrush x:Key="PanelBg" Color="#181B22"/>
    <CornerRadius x:Key="PanelRadius">8</CornerRadius>
    <CornerRadius x:Key="ButtonRadius">6</CornerRadius>
    <!-- Tabs are 26 px tall: half of that makes a pill -->
    <CornerRadius x:Key="TabRadius">5</CornerRadius>
    <CornerRadius x:Key="ThumbRadius">7</CornerRadius>
    <sys:Double x:Key="GlowOpacity">0</sys:Double>
    <sys:Double x:Key="HaloOpacity">0</sys:Double>
    <!-- Accent wash behind the library title -->
    <sys:Double x:Key="WashOpacity">1</sys:Double>
    <sys:Double x:Key="GrainOpacity">0</sys:Double>
</ResourceDictionary>
