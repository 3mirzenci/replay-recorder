<!-- "Windows": Windows 11 dark greys and accent blue, Segoe UI Variable. Default look. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <SolidColorBrush x:Key="Bg" Color="#0E0E10"/>
    <SolidColorBrush x:Key="Panel" Color="#1A1A1C"/>
    <SolidColorBrush x:Key="Card" Color="#252527"/>
    <SolidColorBrush x:Key="CardHover" Color="#2F2F32"/>
    <SolidColorBrush x:Key="Line" Color="#343437"/>
    <SolidColorBrush x:Key="Text" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Subtle" Color="#A2A2A7"/>
    <SolidColorBrush x:Key="Accent" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="OnAccent" Color="#00131F"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#2E4CC2FF"/>
    <SolidColorBrush x:Key="Danger" Color="#FF6B63"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#4A4A4E"/>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="NumFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Keys added for Aurora, here with Classic values: boxes stay, no glow -->
    <SolidColorBrush x:Key="Raised" Color="#1A1A1C"/>
    <SolidColorBrush x:Key="Glass" Color="#252527"/>
    <SolidColorBrush x:Key="Glass2" Color="#2F2F32"/>
    <SolidColorBrush x:Key="Edge" Color="#343437"/>
    <SolidColorBrush x:Key="Faint" Color="#A2A2A7"/>
    <SolidColorBrush x:Key="GameTrack" Color="#A2A2A7"/>
    <SolidColorBrush x:Key="DiscordTrack" Color="#5865F2"/>
    <SolidColorBrush x:Key="Good" Color="#2ECC71"/>
    <SolidColorBrush x:Key="Warn" Color="#E5A84B"/>
    <SolidColorBrush x:Key="Bad" Color="#E5534B"/>
    <SolidColorBrush x:Key="Star" Color="#FFC83D"/>
    <SolidColorBrush x:Key="Tick" Color="#6B6F7A"/>
    <!-- Fullscreen bar over the video: the same in every look -->
    <SolidColorBrush x:Key="Overlay" Color="#960C0C10"/>
    <SolidColorBrush x:Key="OverlaySubtle" Color="#BEBEC8"/>
    <SolidColorBrush x:Key="PanelBg" Color="#1A1A1C"/>
    <CornerRadius x:Key="PanelRadius">8</CornerRadius>
    <CornerRadius x:Key="ButtonRadius">6</CornerRadius>
    <CornerRadius x:Key="ThumbRadius">7</CornerRadius>
    <sys:Double x:Key="GlowOpacity">0</sys:Double>
    <sys:Double x:Key="HaloOpacity">0</sys:Double>
    <sys:Double x:Key="GrainOpacity">0</sys:Double>
</ResourceDictionary>
