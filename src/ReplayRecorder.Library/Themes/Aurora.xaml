<!-- "Aurora": near-black with no boxes, neutral greys, one faint accent glow. Default look (docs/aurora/plan.md). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <SolidColorBrush x:Key="Bg" Color="#070708"/>
    <SolidColorBrush x:Key="Panel" Color="#111113"/>
    <SolidColorBrush x:Key="Card" Color="#18181A"/>
    <SolidColorBrush x:Key="CardHover" Color="#222225"/>
    <SolidColorBrush x:Key="Line" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Text" Color="#F2F2F3"/>
    <SolidColorBrush x:Key="Subtle" Color="#A3A3A8"/>
    <SolidColorBrush x:Key="Accent" Color="#FFC21A"/>
    <SolidColorBrush x:Key="OnAccent" Color="#141210"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#2EFFC21A"/>
    <SolidColorBrush x:Key="Danger" Color="#FF7A72"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#3A3A3E"/>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="NumFont">Bahnschrift, Segoe UI</FontFamily>

    <!-- New in Aurora; Windows.xaml and Amber.xaml carry the same keys with Classic values -->
    <SolidColorBrush x:Key="Raised" Color="#111113"/>
    <SolidColorBrush x:Key="Glass" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Glass2" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="Edge" Color="#262628"/>
    <SolidColorBrush x:Key="Faint" Color="#85858B"/>
    <SolidColorBrush x:Key="GameTrack" Color="#B9B9C0"/>
    <SolidColorBrush x:Key="DiscordTrack" Color="#7B86FF"/>
    <SolidColorBrush x:Key="Good" Color="#2ECC71"/>
    <SolidColorBrush x:Key="Warn" Color="#E5A84B"/>
    <SolidColorBrush x:Key="Bad" Color="#E5534B"/>
    <SolidColorBrush x:Key="Star" Color="#FFC83D"/>
    <SolidColorBrush x:Key="Tick" Color="#4A4A50"/>
    <!-- Fullscreen bar over the video: the same in every look -->
    <SolidColorBrush x:Key="Overlay" Color="#960C0C10"/>
    <SolidColorBrush x:Key="OverlaySubtle" Color="#BEBEC8"/>
    <SolidColorBrush x:Key="PanelBg" Color="Transparent"/>
    <CornerRadius x:Key="PanelRadius">0</CornerRadius>
    <!-- Half a control's height: WPF draws larger radii as an ellipse, not a pill -->
    <CornerRadius x:Key="ButtonRadius">16</CornerRadius>
    <!-- Tabs are 26 px tall: half of that makes a pill -->
    <CornerRadius x:Key="TabRadius">13</CornerRadius>
    <!-- Sticky day header: no box; the clips fade out under it instead (StickyFade masks the list) -->
    <SolidColorBrush x:Key="StickyBg" Color="Transparent"/>
    <SolidColorBrush x:Key="StickyLine" Color="Transparent"/>
    <LinearGradientBrush x:Key="StickyFade" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,70">
        <GradientStop Color="Transparent" Offset="0"/>
        <GradientStop Color="Transparent" Offset="0.6"/>
        <GradientStop Color="Black" Offset="1"/>
    </LinearGradientBrush>
    <!-- Library top row: Aurora has no box, so it sits closer to the window top as in the mock-up -->
    <Thickness x:Key="TopInset">0,-7,0,0</Thickness>
    <CornerRadius x:Key="ThumbRadius">12</CornerRadius>
    <sys:Double x:Key="GlowOpacity">0.10</sys:Double>
    <sys:Double x:Key="HaloOpacity">0.30</sys:Double>
    <!-- Accent wash behind the library title -->
    <sys:Double x:Key="WashOpacity">0</sys:Double>
    <sys:Double x:Key="GrainOpacity">0.03</sys:Double>
</ResourceDictionary>
