<Window x:Class="ReplayRecorder.Library.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ReplayRecorder.Library"
        xmlns:player="clr-namespace:ReplayRecorder.Library.Player"
        Title="Replay Recorder" Width="1320" Height="840" MinWidth="900" MinHeight="560"
        Background="{DynamicResource Bg}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Round buttons for the header's action row -->
        <Style x:Key="RoundBtn" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="100">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Card}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TransportBtn" TargetType="Button" BasedOn="{StaticResource RoundBtn}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="{DynamicResource Glass}"/>
        </Style>
        <Style x:Key="PlayCircle" TargetType="Button" BasedOn="{StaticResource RoundBtn}">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="100">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.05" ScaleY="1.05"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Day header in the grid, also used for the sticky header at the top while scrolling.
             DataContext is the CollectionViewGroup; Name is the shared DayGroup. -->
                    <DataTemplate x:Key="DayHeaderTemplate">
                        <Border Background="Transparent" Cursor="Hand" Padding="18,24,8,14" HorizontalAlignment="Left"
                                MouseLeftButtonDown="DayHeader_Click" ToolTip="Select every clip from this day">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="chk" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5"
                                        BorderBrush="{DynamicResource Faint}" Background="Transparent" VerticalAlignment="Center">
                                    <TextBlock x:Name="mark" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Name.Label}" FontFamily="{DynamicResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name.Summary}" Foreground="{DynamicResource Subtle}" FontSize="13" Margin="10,2,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Name.State}" Value="1">
                                <Setter TargetName="chk" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="mark" Property="Text" Value="&#xE738;"/>
                                <Setter TargetName="mark" Property="Foreground" Value="{DynamicResource Accent}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Name.State}" Value="2">
                                <Setter TargetName="chk" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="chk" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="mark" Property="Text" Value="&#xE73E;"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
    </Window.Resources>
    <Grid>
        <!-- ================= Library ================= -->
        <Grid x:Name="LibraryView" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Faint accent light from the top edge; tiled grain over it hides gradient banding -->
            <Rectangle Grid.RowSpan="3" Margin="-8" Fill="{DynamicResource AccentGlow}" IsHitTestVisible="False"/>
            <Rectangle Grid.RowSpan="3" Margin="-8" Fill="{DynamicResource Grain}" Opacity="{DynamicResource GrainOpacity}"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False">
                <Rectangle.OpacityMask>
                    <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.71" RadiusY="0.6">
                        <GradientStop Color="Black" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>

            <!-- Top bar: app, game filter, search, folder and settings (a box in Classic only) -->
            <Border CornerRadius="{DynamicResource PanelRadius}" Background="{DynamicResource PanelBg}" Padding="22,9" Margin="{DynamicResource TopInset}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource Accent}">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource OnAccent}"/>
                        </Border>
                        <TextBlock Text="Replay Recorder" FontFamily="{DynamicResource DisplayFont}" FontSize="15.5" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <!-- Not shown: their text feeds the two buttons' hover text -->
                        <TextBlock x:Name="StorageText" Visibility="Collapsed"/>
                        <TextBlock x:Name="VersionText" Visibility="Collapsed"/>
                        <TextBox x:Name="SearchBox" Style="{StaticResource Search}" Width="230" Margin="0,0,10,0" TextChanged="SearchBox_TextChanged"/>
                        <Button x:Name="OpenFolderBtn" Style="{StaticResource RoundBtn}" Click="OpenFolder_Click"
                                ToolTip="{Binding Text, ElementName=StorageText}" ToolTipService.ShowDuration="20000">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
                        </Button>
                        <Button x:Name="SettingsBtn" Style="{StaticResource RoundBtn}" Margin="4,0,0,0" Click="Settings_Click" ToolTip="Settings">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
                        </Button>
                    </StackPanel>
                    <!-- Game pills (MainWindow.Games.cs); the host takes the room left between logo and search -->
                    <Border x:Name="GameHost" ClipToBounds="True" SizeChanged="GameHost_SizeChanged">
                        <StackPanel x:Name="GamePills" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Main panel -->
            <Border Grid.Row="2" CornerRadius="{DynamicResource PanelRadius}" Background="{DynamicResource PanelBg}">
            <DockPanel>
                <!-- Header: accent wash (Classic only; Aurora has the glow), big title, sort tabs -->
                <Grid DockPanel.Dock="Top">
                    <Border CornerRadius="{DynamicResource PanelRadius}" Background="{DynamicResource AccentSoft}" Opacity="{DynamicResource WashOpacity}">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Black" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                    </Border>
                    <!-- One row: title and count, sort tabs at the right end -->
                    <DockPanel Margin="22,15,22,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <RadioButton Style="{StaticResource SegRadio}" Content="Newest" IsChecked="True" Tag="newest" Checked="Sort_Checked" GroupName="sort"/>
                            <RadioButton Style="{StaticResource SegRadio}" Content="Oldest" Margin="4,0,0,0" Tag="oldest" Checked="Sort_Checked" GroupName="sort"/>
                            <RadioButton Style="{StaticResource SegRadio}" Content="Longest" Margin="4,0,0,0" Tag="longest" Checked="Sort_Checked" GroupName="sort"/>
                            <RadioButton Style="{StaticResource SegRadio}" Content="Largest" Margin="4,0,0,0" Tag="largest" Checked="Sort_Checked" GroupName="sort"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderText" Text="All clips" FontFamily="{DynamicResource DisplayFont}" FontSize="36" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CountText" Foreground="{DynamicResource Subtle}" FontSize="14" Margin="14,8,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <!-- Shown when GitHub has a newer release -->
                <Border x:Name="UpdatePanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="22,8,22,4" Padding="14,10" CornerRadius="8"
                        HorizontalAlignment="Left" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel VerticalAlignment="Center" MaxWidth="420">
                            <TextBlock x:Name="UpdateTitle" Text="Update available" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="UpdateText" Foreground="{DynamicResource Subtle}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="UpdateBtn" Style="{StaticResource AccentBtn}" VerticalAlignment="Center" Margin="16,0,0,0" Click="Update_Click">
                            <TextBlock x:Name="UpdateBtnText" Text="Update now" Foreground="{DynamicResource OnAccent}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Selection bar: actions for every selected clip -->
                <Border x:Name="SelectionBar" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="22,0,22,16" Padding="14,10"
                        Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostBtn}" Padding="8,6" Click="ClearSelection_Click" ToolTip="Clear selection (Esc)">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                            </Button>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectionText" FontSize="13.5" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SelectionDetail" Foreground="{DynamicResource Subtle}" FontSize="11.5"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Batch export progress / result -->
                        <StackPanel x:Name="BatchPanel" Grid.Column="1" Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border x:Name="BatchDragTile" Padding="10,6" CornerRadius="8" Background="{DynamicResource Card}"
                                    BorderBrush="{DynamicResource Accent}" BorderThickness="1" Cursor="Hand" Visibility="Collapsed"
                                    PreviewMouseLeftButtonDown="BatchDrag_Down" PreviewMouseMove="BatchDrag_Move"
                                    ToolTip="Drag into a Discord chat (Discord takes up to 10 files per message)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="BatchDragText" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="BatchProgress" Width="220" VerticalAlignment="Center">
                                <TextBlock x:Name="BatchStatus" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Line}" Margin="0,5,0,0" ClipToBounds="True">
                                    <Border x:Name="BatchBar" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="{DynamicResource Accent}"/>
                                </Border>
                            </StackPanel>
                            <Button x:Name="BatchCopyBtn" Content="Copy files" Margin="10,0,0,0" Click="BatchCopy_Click" Visibility="Collapsed"
                                    ToolTip="Then press Ctrl+V in Discord"/>
                            <Button x:Name="BatchCancelBtn" Content="Cancel" Margin="10,0,0,0" Style="{StaticResource GhostBtn}" Click="BatchCancel_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SelOpenBtn" Content="Open" Margin="0,0,6,0" Click="SelOpen_Click"/>
                            <Button Content="Show in folder" Margin="0,0,6,0" Click="SelShow_Click"/>
                            <Button Content="Copy files" Margin="0,0,6,0" Click="SelCopy_Click"
                                    ToolTip="Copy the original clips, then paste them anywhere (Ctrl+V)"/>
                            <Button x:Name="SelExportBtn" Style="{StaticResource AccentBtn}" Margin="0,0,6,0" Click="SelExport_Click"
                                    ToolTip="Export each selected clip under the Discord size limit, with its saved trim and volumes">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource OnAccent}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Export for Discord" Margin="8,0,0,0" Foreground="{DynamicResource OnAccent}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Click="SelDelete_Click" ToolTip="Delete for good (Del)">
                                <TextBlock Text="Delete" Foreground="{DynamicResource Danger}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid>
                    <ListBox x:Name="ClipGrid" Background="Transparent" BorderThickness="0" Padding="4,0,12,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Extended" IsSynchronizedWithCurrentItem="False"
                             VirtualizingPanel.IsVirtualizing="False" SelectionChanged="ClipGrid_SelectionChanged"
                             PreviewMouseLeftButtonDown="ClipGrid_LeftDown" PreviewMouseLeftButtonUp="ClipGrid_LeftUp" KeyDown="ClipGrid_KeyDown"
                             PreviewMouseRightButtonDown="ClipGrid_RightDown" ContextMenuOpening="ClipGrid_ContextMenuOpening">
                        <ListBox.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource DayHeaderTemplate}">
                                <!-- Plain group: the default one indents the cards a few px past the day header -->
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <StackPanel>
                                                        <ContentPresenter/>
                                                        <ItemsPresenter/>
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <!-- No box: the thumbnail is the card. 18 px between columns, 24 between rows. -->
                                            <Border Margin="18,0,0,24" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <!-- On the ListBox (not in the item style): WPF can't wire Click handlers
                             inside a style-setter ContextMenu. Right-click selects the card first. -->
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="CtxOpen" Header="Open" Click="CtxOpen_Click"/>
                                <MenuItem x:Name="CtxRename" Header="Rename…" InputGestureText="F2" Click="CtxRename_Click"/>
                                <MenuItem x:Name="CtxFav" Header="Add to favorites" Click="CtxFav_Click"/>
                                <MenuItem Header="Show in folder" Click="SelShow_Click"/>
                                <MenuItem Header="Copy files" Click="SelCopy_Click"/>
                                <MenuItem x:Name="CtxExport" Header="Export for Discord" Click="SelExport_Click"/>
                                <MenuItem Header="Select whole day" Click="CtxSelectDay_Click"/>
                                <Separator/>
                                <MenuItem x:Name="CtxDelete" Header="Delete" InputGestureText="Del" Foreground="{DynamicResource Danger}" Click="SelDelete_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ClipItem}">
                                <StackPanel Width="{Binding Path=(local:ClipItem.TileWidth)}">
                                    <Grid x:Name="th" Height="{Binding Path=(local:ClipItem.ThumbHeight)}" Background="Transparent"
                                          MouseMove="Thumb_MouseMove" MouseLeave="Thumb_MouseLeave">
                                        <!-- Thin edge; lifts with a soft accent shadow on hover; accent outline when selected -->
                                        <Border x:Name="edge" Margin="-1" CornerRadius="{DynamicResource ThumbRadius}" Background="#0A0B0E"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="1"/>
                                        <Grid Clip="{Binding Path=(local:ClipItem.ThumbClip)}">
                                            <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                            <!-- Hover scrub: 10 frames side by side, shifted so the one under the mouse shows -->
                                            <Canvas x:Name="scrub" ClipToBounds="True" Visibility="Collapsed">
                                                <Image Source="{Binding Storyboard}" Width="{Binding Path=(local:ClipItem.StripWidth)}"
                                                       Height="{Binding Path=(local:ClipItem.ThumbHeight)}" Stretch="Fill" Canvas.Left="{Binding ScrubOffset}"/>
                                            </Canvas>
                                            <Border x:Name="scrubBar" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                    Width="{Binding ScrubBarWidth}" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                                            <!-- Clip wall: game and time on the picture, over a dark fade for legibility -->
                                            <Border x:Name="overlay" VerticalAlignment="Bottom" Height="70" Visibility="Collapsed" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00000000" Offset="0"/>
                                                        <GradientStop Color="#D9000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel VerticalAlignment="Bottom" Margin="11,0,70,9">
                                                    <TextBlock Text="{Binding Game}" FontFamily="{DynamicResource DisplayFont}" FontSize="15" FontWeight="SemiBold"
                                                               Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="#D0FFFFFF" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Border x:Name="star" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Width="24" Height="24"
                                                CornerRadius="12" Background="#80000000" Cursor="Hand" Opacity="0" ToolTip="Favorite"
                                                PreviewMouseLeftButtonDown="Star_Down">
                                            <TextBlock x:Name="starGlyph" Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="newBadge" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="7,2"
                                                CornerRadius="6" Background="{DynamicResource Accent}" Visibility="Collapsed">
                                            <TextBlock Text="{x:Static local:ClipItem.NewLabel}" FontFamily="{DynamicResource NumFont}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource OnAccent}"/>
                                        </Border>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Padding="7,2"
                                                CornerRadius="6" Background="#B8000000">
                                            <TextBlock Text="{Binding DurationText}" FontFamily="{DynamicResource NumFont}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                        <!-- Select circle: toggles this card without touching the rest of the selection -->
                                        <Border x:Name="check" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Width="22" Height="22"
                                                CornerRadius="11" Background="#80000000" BorderBrush="#D9FFFFFF" BorderThickness="1.5"
                                                Cursor="Hand" Opacity="0" ToolTip="Select" PreviewMouseLeftButtonDown="CardCheck_Down">
                                            <TextBlock x:Name="checkMark" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>
                                        </Border>
                                    </Grid>
                                    <!-- Label: name and time on one baseline; size and quality at the right on hover/selection -->
                                    <DockPanel x:Name="info" Margin="2,10,2,3">
                                        <TextBlock x:Name="detail" DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{DynamicResource Faint}" FontSize="12"
                                                   Margin="10,0,0,0" VerticalAlignment="Bottom" Opacity="0"/>
                                        <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom">
                                            <Run Text="{Binding DisplayName, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"/><Run Text="  "/><Run
                                                 Text="{Binding TimeText, Mode=OneWay}" FontSize="13" FontFamily="{DynamicResource NumFont}" Foreground="{DynamicResource Subtle}"/>
                                        </TextBlock>
                                    </DockPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="check" Property="Opacity" Value="1"/>
                                        <Setter TargetName="star" Property="Opacity" Value="1"/>
                                        <Setter TargetName="detail" Property="Opacity" Value="1"/>
                                        <Setter TargetName="th" Property="RenderTransform">
                                            <Setter.Value><TranslateTransform Y="-3"/></Setter.Value>
                                        </Setter>
                                        <Setter TargetName="edge" Property="BorderBrush" Value="#2EFFFFFF"/>
                                        <Setter TargetName="edge" Property="Effect" Value="{DynamicResource HoverGlow}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter TargetName="star" Property="Opacity" Value="1"/>
                                        <Setter TargetName="starGlyph" Property="Text" Value="&#xE735;"/>
                                        <Setter TargetName="starGlyph" Property="Foreground" Value="{DynamicResource Star}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsNew}" Value="True">
                                        <Setter TargetName="newBadge" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="wall">
                                        <Setter TargetName="overlay" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="info" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsScrubbing}" Value="True">
                                        <Setter TargetName="scrub" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="scrubBar" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <!-- While several clips are selected, every card shows its circle -->
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="multi">
                                        <Setter TargetName="check" Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="check" Property="Opacity" Value="1"/>
                                        <Setter TargetName="check" Property="Background" Value="{DynamicResource Accent}"/>
                                        <Setter TargetName="check" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="detail" Property="Opacity" Value="1"/>
                                        <Setter TargetName="edge" Property="Margin" Value="-2"/>
                                        <Setter TargetName="edge" Property="BorderThickness" Value="2"/>
                                        <Setter TargetName="edge" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Sticky day header: shows the current day while its own header is scrolled away -->
                    <Border x:Name="StickyHeader" VerticalAlignment="Top" Margin="4,0,30,0" Visibility="Collapsed"
                            Background="{DynamicResource StickyBg}" BorderBrush="{DynamicResource StickyLine}" BorderThickness="0,0,0,1">
                        <ContentControl x:Name="StickyContent" ContentTemplate="{StaticResource DayHeaderTemplate}" Margin="0,-10,0,8"/>
                    </Border>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="No clips yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyHint" Foreground="{DynamicResource Subtle}" Margin="0,6,0,0" HorizontalAlignment="Center"
                                   Text="Press your save-clip hotkey in a game and it shows up here."/>
                    </StackPanel>
                </Grid>
            </DockPanel>
            </Border>
        </Grid>

        <!-- ================= Player ================= -->
        <Grid x:Name="PlayerView" Visibility="Collapsed" Background="{DynamicResource Bg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Panels behind the rows: header + video on top, timeline + controls below -->
            <Rectangle Grid.RowSpan="5" Fill="{DynamicResource AccentGlow}" IsHitTestVisible="False"/>
            <Rectangle Grid.RowSpan="5" Fill="{DynamicResource Grain}" Opacity="{DynamicResource GrainOpacity}"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False">
                <Rectangle.OpacityMask>
                    <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.71" RadiusY="0.6">
                        <GradientStop Color="Black" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Border x:Name="PlayerTopPanel" Grid.RowSpan="2" Margin="8,8,8,0" CornerRadius="{DynamicResource PanelRadius}" Background="{DynamicResource PanelBg}"/>
            <Border x:Name="PlayerBottomPanel" Grid.Row="2" Grid.RowSpan="2" Margin="8" CornerRadius="{DynamicResource PanelRadius}" Background="{DynamicResource PanelBg}"/>

            <!-- Header -->
            <DockPanel x:Name="PlayerHeader" Height="58" Margin="30,1,30,0">
                <Button DockPanel.Dock="Left" Click="Back_Click" ToolTip="Back to library (Esc)" Padding="8,0,12,0" Height="32" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Subtle}" VerticalAlignment="Center"/>
                        <TextBlock Text="Library" Margin="8,0,0,0" Foreground="{DynamicResource Subtle}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Show in folder" Click="PlayerShow_Click" Padding="15,0" Height="34" Margin="0,0,8,0"/>
                    <Button Click="PlayerDelete_Click" ToolTip="Delete for good (Del)" Padding="15,0" Height="34">
                        <TextBlock Text="Delete" Foreground="{DynamicResource Danger}"/>
                    </Button>
                </StackPanel>
                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PlayerTitle" FontFamily="{DynamicResource DisplayFont}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PlayerSubtitle" Foreground="{DynamicResource Subtle}" FontSize="12.5" Margin="0,1,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Video -->
            <Grid x:Name="VideoStage" Grid.Row="1" Margin="30,14,30,0" SizeChanged="VideoStage_SizeChanged">
                <!-- Accent halo: the video's size, scaled out 120 px each way and 30 px down in FitVideo (a render
                     transform, so the stage doesn't clip it) -->
                <Rectangle x:Name="VideoHalo" Fill="{DynamicResource AccentHalo}" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"
                           Width="{Binding ActualWidth, ElementName=VideoFrame}" Height="{Binding ActualHeight, ElementName=VideoFrame}"/>
                <Border x:Name="VideoFrame" Background="#000">
                    <Grid>
                        <player:VideoHost x:Name="Video"/>
                        <TextBlock x:Name="PlayerError" Visibility="Collapsed" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Timeline -->
            <player:TrimTimeline x:Name="Timeline" Grid.Row="2" Margin="30,26,30,0"/>

            <!-- Controls: trim tools left, transport centred, mix + export right -->
            <Grid x:Name="PlayerControls" Grid.Row="3" Margin="30,14,30,30" SizeChanged="PlayerControls_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Row 1 is used only when the window is too narrow for the mix + export beside the transport. -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Both sides share one width, so the play button sits exactly in the middle. -->
                <Grid x:Name="Transport" Grid.Column="1" VerticalAlignment="Center" Margin="16,0" Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="TransportSide"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="TransportSide"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource TransportBtn}" Click="StepBack_Click" ToolTip="Previous frame (←)" HorizontalAlignment="Right">
                        <TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
                    </Button>
                    <Button x:Name="PlayBtn" Grid.Column="1" Style="{StaticResource PlayCircle}" Margin="12,0" Click="Play_Click" ToolTip="Play / pause (Space)">
                        <TextBlock x:Name="PlayIcon" Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource OnAccent}"/>
                    </Button>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource TransportBtn}" Click="StepFwd_Click" ToolTip="Next frame (→)">
                            <TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
                        </Button>
                        <Button Style="{StaticResource TransportBtn}" Click="Fullscreen_Click" Margin="12,0,0,0" ToolTip="Fullscreen (F)">
                            <TextBlock Text="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
                        </Button>
                        <!-- Position bright, length grey; same font, so one baseline -->
                        <TextBlock x:Name="TimeText" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="16" FontFamily="{DynamicResource NumFont}"
                                   Typography.NumeralAlignment="Tabular"/>
                        <TextBlock x:Name="TimeTotal" VerticalAlignment="Center" FontSize="16" FontFamily="{DynamicResource NumFont}"
                                   Foreground="{DynamicResource Subtle}" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                </Grid>

                <WrapPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Content="Set start  (I)" Click="SetIn_Click" Padding="12,0" Height="33" Margin="0,0,6,0"/>
                    <Button Content="Set end  (O)" Click="SetOut_Click" Padding="12,0" Height="33" Margin="0,0,6,0"/>
                    <ToggleButton x:Name="PreviewToggle" Style="{StaticResource GamePill}" Content="Preview trim  (P)" Click="Preview_Click"
                                  Background="{DynamicResource Glass}" Foreground="{DynamicResource Text}" Padding="12,0" Height="33" Margin="0,0,6,0"/>
                    <Button Content="Reset" Click="ResetTrim_Click" Style="{StaticResource GhostBtn}"/>
                    <TextBlock x:Name="TrimText" Foreground="{DynamicResource Subtle}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12.5"/>
                </WrapPanel>

                <StackPanel x:Name="RightControls" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel x:Name="MixPanel" Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,0">
                            <DockPanel Width="150">
                                <TextBlock x:Name="GameVolText" DockPanel.Dock="Right" Foreground="{DynamicResource Subtle}" FontSize="11.5"/>
                                <TextBlock x:Name="GameVolLabel" Text="Game + chat" FontSize="11.5" Foreground="{DynamicResource Subtle}"/>
                            </DockPanel>
                            <Slider x:Name="GameVol" Minimum="-30" Maximum="20" Value="0" SmallChange="1" LargeChange="3"
                                    ValueChanged="Volume_ValueChanged" MouseDoubleClick="GameVol_DoubleClick" Width="150"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <DockPanel Width="150">
                                <TextBlock x:Name="MicVolText" DockPanel.Dock="Right" Foreground="{DynamicResource Subtle}" FontSize="11.5"/>
                                <TextBlock Text="Your mic" FontSize="11.5" Foreground="{DynamicResource Subtle}"/>
                            </DockPanel>
                            <Slider x:Name="MicVol" Minimum="-30" Maximum="20" Value="0" SmallChange="1" LargeChange="3"
                                    ValueChanged="Volume_ValueChanged" MouseDoubleClick="MicVol_DoubleClick" Width="150"/>
                        </StackPanel>
                        <StackPanel x:Name="DiscordMix" Margin="0,0,16,0" Visibility="Collapsed">
                            <DockPanel Width="150">
                                <TextBlock x:Name="DiscordVolText" DockPanel.Dock="Right" Foreground="{DynamicResource Subtle}" FontSize="11.5"/>
                                <TextBlock Text="Discord" FontSize="11.5" Foreground="{DynamicResource Subtle}"/>
                            </DockPanel>
                            <Slider x:Name="DiscordVol" Minimum="-30" Maximum="20" Value="0" SmallChange="1" LargeChange="3"
                                    ValueChanged="Volume_ValueChanged" MouseDoubleClick="DiscordVol_DoubleClick" Width="150"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="ExportBtn" Style="{StaticResource AccentBtn}" Padding="14,8" Click="Export_Click"
                            ToolTip="Export the trimmed range as an MP4 under the Discord size limit (E)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource OnAccent}" VerticalAlignment="Center"/>
                            <TextBlock Text="Export for Discord" Margin="8,0,0,0" Foreground="{DynamicResource OnAccent}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Export panel (shown while exporting and afterwards) -->
            <Border x:Name="ExportPanel" Grid.Row="4" Visibility="Collapsed" Margin="8,0,8,8" Padding="14"
                    Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Drag source: a real OS file drag, drop it on a Discord chat -->
                    <Border x:Name="DragTile" Width="250" Padding="12,10" CornerRadius="8" Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="1" Cursor="Hand" Opacity="0.4"
                            PreviewMouseLeftButtonDown="DragTile_Down" PreviewMouseMove="DragTile_Move"
                            ToolTip="Drag this into a Discord chat">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Accent}">
                                <TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource OnAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="180">
                                <TextBlock Text="Drag into Discord" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock x:Name="ExportFileText" Foreground="{DynamicResource Subtle}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock x:Name="ExportSizeText" DockPanel.Dock="Right" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="ExportStatus" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Border Height="6" CornerRadius="3" Background="{DynamicResource Line}" Margin="0,8,0,0" ClipToBounds="True">
                            <Border x:Name="ExportBar" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="{DynamicResource Accent}"/>
                        </Border>
                        <TextBlock x:Name="ExportDetail" Foreground="{DynamicResource Subtle}" FontSize="11.5" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CopyFileBtn" Content="Copy file" Click="CopyFile_Click" Margin="0,0,6,0" IsEnabled="False"
                                ToolTip="Then press Ctrl+V in Discord"/>
                        <Button x:Name="OpenExportBtn" Content="Open folder" Click="OpenExport_Click" Margin="0,0,6,0" IsEnabled="False"/>
                        <Button x:Name="CancelExportBtn" Content="Cancel" Click="CancelExport_Click" Style="{StaticResource GhostBtn}"/>
                        <Button x:Name="CloseExportBtn" Click="CloseExport_Click" Style="{StaticResource GhostBtn}" Padding="8,6" Visibility="Collapsed">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Undo after delete ================= -->
        <Border x:Name="UndoBar" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                Padding="16,8,8,8" CornerRadius="8" Background="{DynamicResource CardHover}">
            <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.4"/></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="UndoText" VerticalAlignment="Center" FontSize="13"/>
                <Button Content="Undo" Click="Undo_Click" Style="{StaticResource AccentBtn}" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
