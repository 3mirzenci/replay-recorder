<Window x:Class="ReplayRecorder.Library.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ReplayRecorder.Library"
        xmlns:player="clr-namespace:ReplayRecorder.Library.Player"
        Title="Replay Recorder" Width="1320" Height="840" MinWidth="900" MinHeight="560"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Day header in the grid, also used for the sticky header at the top while scrolling.
             DataContext is the CollectionViewGroup; Name is the shared DayGroup. -->
                    <DataTemplate x:Key="DayHeaderTemplate">
                        <Border Background="Transparent" Cursor="Hand" Padding="8,16,8,2" HorizontalAlignment="Left"
                                MouseLeftButtonDown="DayHeader_Click" ToolTip="Select every clip from this day">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="chk" Width="20" Height="20" CornerRadius="10" BorderThickness="1.5"
                                        BorderBrush="{StaticResource Subtle}" Background="Transparent" VerticalAlignment="Center">
                                    <TextBlock x:Name="mark" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Name.Label}" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name.Summary}" Foreground="{StaticResource Subtle}" FontSize="12.5" Margin="10,2,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Name.State}" Value="1">
                                <Setter TargetName="chk" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="mark" Property="Text" Value="&#xE738;"/>
                                <Setter TargetName="mark" Property="Foreground" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Name.State}" Value="2">
                                <Setter TargetName="chk" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="chk" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="mark" Property="Text" Value="&#xE73E;"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
    </Window.Resources>
    <Grid>
        <!-- ================= Library ================= -->
        <Grid x:Name="LibraryView">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,18,14,14">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource Accent}">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Replay Recorder" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="6,10,0,0">
                        <!-- Shown when GitHub has a newer release -->
                        <Border x:Name="UpdatePanel" Visibility="Collapsed" Margin="-6,0,0,14" Padding="12,10" CornerRadius="8"
                                Background="{StaticResource Card}" BorderBrush="{StaticResource Accent}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="UpdateTitle" Text="Update available" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock x:Name="UpdateText" Foreground="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <Button x:Name="UpdateBtn" Style="{StaticResource AccentBtn}" HorizontalAlignment="Left" Click="Update_Click">
                                    <TextBlock x:Name="UpdateBtnText" Text="Update now" Foreground="White"/>
                                </Button>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="StorageText" Foreground="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap"/>
                        <Button x:Name="OpenFolderBtn" Content="Open clips folder" Margin="0,10,0,0" HorizontalAlignment="Left" Click="OpenFolder_Click"/>
                        <Button Margin="0,6,0,0" HorizontalAlignment="Left" Click="Settings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="VersionText" Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,10,0,0" Opacity="0.7"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="GAMES" Foreground="{StaticResource Subtle}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,8"/>
                    <ListBox x:Name="GameList" Background="Transparent" BorderThickness="0" SelectionChanged="GameList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" CornerRadius="6" Padding="10,7" Margin="0,1" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Card}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:GameEntry}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{StaticResource Subtle}" FontSize="12"/>
                                    <TextBlock Text="{Binding Label}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Main area -->
            <DockPanel Grid.Column="1">
                <Grid DockPanel.Dock="Top" Margin="24,16,24,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="HeaderText" Text="All clips" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CountText" Foreground="{StaticResource Subtle}" FontSize="12.5" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource Card}" CornerRadius="7" Padding="3" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegRadio}" Content="Newest" IsChecked="True" Tag="newest" Checked="Sort_Checked" GroupName="sort"/>
                                <RadioButton Style="{StaticResource SegRadio}" Content="Oldest" Tag="oldest" Checked="Sort_Checked" GroupName="sort"/>
                                <RadioButton Style="{StaticResource SegRadio}" Content="Longest" Tag="longest" Checked="Sort_Checked" GroupName="sort"/>
                                <RadioButton Style="{StaticResource SegRadio}" Content="Largest" Tag="largest" Checked="Sort_Checked" GroupName="sort"/>
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="SearchBox" Style="{StaticResource Search}" Width="240" TextChanged="SearchBox_TextChanged"/>
                    </StackPanel>
                </Grid>

                <!-- Selection bar: actions for every selected clip -->
                <Border x:Name="SelectionBar" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="24,0,24,16" Padding="14,10"
                        Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostBtn}" Padding="8,6" Click="ClearSelection_Click" ToolTip="Clear selection (Esc)">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                            </Button>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectionText" FontSize="13.5" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SelectionDetail" Foreground="{StaticResource Subtle}" FontSize="11.5"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Batch export progress / result -->
                        <StackPanel x:Name="BatchPanel" Grid.Column="1" Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border x:Name="BatchDragTile" Padding="10,6" CornerRadius="8" Background="{StaticResource Card}"
                                    BorderBrush="{StaticResource Accent}" BorderThickness="1" Cursor="Hand" Visibility="Collapsed"
                                    PreviewMouseLeftButtonDown="BatchDrag_Down" PreviewMouseMove="BatchDrag_Move"
                                    ToolTip="Drag into a Discord chat (Discord takes up to 10 files per message)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="BatchDragText" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="BatchProgress" Width="220" VerticalAlignment="Center">
                                <TextBlock x:Name="BatchStatus" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <Border Height="4" CornerRadius="2" Background="{StaticResource Line}" Margin="0,5,0,0" ClipToBounds="True">
                                    <Border x:Name="BatchBar" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="{StaticResource Accent}"/>
                                </Border>
                            </StackPanel>
                            <Button x:Name="BatchCopyBtn" Content="Copy files" Margin="10,0,0,0" Click="BatchCopy_Click" Visibility="Collapsed"
                                    ToolTip="Then press Ctrl+V in Discord"/>
                            <Button x:Name="BatchCancelBtn" Content="Cancel" Margin="10,0,0,0" Style="{StaticResource GhostBtn}" Click="BatchCancel_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SelOpenBtn" Content="Open" Margin="0,0,6,0" Click="SelOpen_Click"/>
                            <Button Content="Show in folder" Margin="0,0,6,0" Click="SelShow_Click"/>
                            <Button Content="Copy files" Margin="0,0,6,0" Click="SelCopy_Click"
                                    ToolTip="Copy the original clips, then paste them anywhere (Ctrl+V)"/>
                            <Button x:Name="SelExportBtn" Style="{StaticResource AccentBtn}" Margin="0,0,6,0" Click="SelExport_Click"
                                    ToolTip="Export each selected clip under the Discord size limit, with its saved trim and volumes">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="Export for Discord" Margin="8,0,0,0" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Click="SelDelete_Click" ToolTip="Delete for good (Del)">
                                <TextBlock Text="Delete" Foreground="{StaticResource Danger}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid>
                    <ListBox x:Name="ClipGrid" Background="Transparent" BorderThickness="0" Padding="16,0,16,16"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Extended" IsSynchronizedWithCurrentItem="False"
                             VirtualizingPanel.IsVirtualizing="False" SelectionChanged="ClipGrid_SelectionChanged"
                             PreviewMouseLeftButtonDown="ClipGrid_LeftDown" PreviewMouseLeftButtonUp="ClipGrid_LeftUp" KeyDown="ClipGrid_KeyDown"
                             PreviewMouseRightButtonDown="ClipGrid_RightDown" ContextMenuOpening="ClipGrid_ContextMenuOpening">
                        <ListBox.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource DayHeaderTemplate}"/>
                        </ListBox.GroupStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" CornerRadius="10" Margin="8" Background="{StaticResource Card}"
                                                    BorderBrush="Transparent" BorderThickness="2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <!-- On the ListBox (not in the item style): WPF can't wire Click handlers
                             inside a style-setter ContextMenu. Right-click selects the card first. -->
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="CtxOpen" Header="Open" Click="CtxOpen_Click"/>
                                <MenuItem x:Name="CtxRename" Header="Rename…" InputGestureText="F2" Click="CtxRename_Click"/>
                                <MenuItem x:Name="CtxFav" Header="Add to favorites" Click="CtxFav_Click"/>
                                <MenuItem Header="Show in folder" Click="SelShow_Click"/>
                                <MenuItem Header="Copy files" Click="SelCopy_Click"/>
                                <MenuItem x:Name="CtxExport" Header="Export for Discord" Click="SelExport_Click"/>
                                <MenuItem Header="Select whole day" Click="CtxSelectDay_Click"/>
                                <Separator/>
                                <MenuItem x:Name="CtxDelete" Header="Delete" Click="SelDelete_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ClipItem}">
                                <StackPanel Width="296">
                                    <Grid Height="166" Background="Transparent" MouseMove="Thumb_MouseMove" MouseLeave="Thumb_MouseLeave">
                                        <Border CornerRadius="8,8,0,0" Background="#101116" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                                <!-- Hover scrub: 10 frames side by side, shifted so the one under the mouse shows -->
                                                <Canvas x:Name="scrub" ClipToBounds="True" Visibility="Collapsed">
                                                    <Image Source="{Binding Storyboard}" Width="2960" Height="166" Stretch="Fill" Canvas.Left="{Binding ScrubOffset}"/>
                                                </Canvas>
                                                <Border x:Name="scrubBar" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                        Width="{Binding ScrubBarWidth}" Background="{StaticResource Accent}" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="star" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Width="26" Height="26"
                                                CornerRadius="13" Background="#99000000" Cursor="Hand" Opacity="0" ToolTip="Favorite"
                                                PreviewMouseLeftButtonDown="Star_Down">
                                            <TextBlock x:Name="starGlyph" Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Padding="6,2"
                                                CornerRadius="4" Background="#CC000000">
                                            <TextBlock Text="{Binding DurationText}" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Border>
                                        <!-- Select circle: toggles this card without touching the rest of the selection -->
                                        <Border x:Name="check" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Width="24" Height="24"
                                                CornerRadius="12" Background="#99000000" BorderBrush="#E6FFFFFF" BorderThickness="1.5"
                                                Cursor="Hand" Opacity="0" ToolTip="Select" PreviewMouseLeftButtonDown="CardCheck_Down">
                                            <TextBlock x:Name="checkMark" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Margin="12,10,12,12">
                                        <TextBlock Text="{Binding Game}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Subtle}" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="check" Property="Opacity" Value="1"/>
                                        <Setter TargetName="star" Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter TargetName="star" Property="Opacity" Value="1"/>
                                        <Setter TargetName="starGlyph" Property="Text" Value="&#xE735;"/>
                                        <Setter TargetName="starGlyph" Property="Foreground" Value="#FFC83D"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsScrubbing}" Value="True">
                                        <Setter TargetName="scrub" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="scrubBar" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <!-- While several clips are selected, every card shows its circle -->
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="multi">
                                        <Setter TargetName="check" Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="check" Property="Opacity" Value="1"/>
                                        <Setter TargetName="check" Property="Background" Value="{StaticResource Accent}"/>
                                        <Setter TargetName="check" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                        <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Sticky day header: shows the current day while its own header is scrolled away -->
                    <Border x:Name="StickyHeader" VerticalAlignment="Top" Margin="16,0,30,0" Visibility="Collapsed"
                            Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                        <ContentControl x:Name="StickyContent" ContentTemplate="{StaticResource DayHeaderTemplate}" Margin="0,-10,0,8"/>
                    </Border>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="No clips yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyHint" Foreground="{StaticResource Subtle}" Margin="0,6,0,0" HorizontalAlignment="Center"
                                   Text="Press your save-clip hotkey in a game and it shows up here."/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- ================= Player ================= -->
        <Grid x:Name="PlayerView" Visibility="Collapsed" Background="{StaticResource Bg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Margin="16,12,16,10">
                <Button DockPanel.Dock="Left" Style="{StaticResource GhostBtn}" Click="Back_Click" ToolTip="Back to library (Esc)" Padding="8,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Library" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Show in folder" Click="PlayerShow_Click" Margin="0,0,8,0"/>
                    <Button Click="PlayerDelete_Click" ToolTip="Delete for good (Del)">
                        <TextBlock Text="Delete" Foreground="{StaticResource Danger}"/>
                    </Button>
                </StackPanel>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PlayerTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PlayerSubtitle" Foreground="{StaticResource Subtle}" FontSize="12"/>
                </StackPanel>
            </DockPanel>

            <!-- Video -->
            <Border Grid.Row="1" Background="#000" Margin="16,0">
                <Grid>
                    <player:VideoHost x:Name="Video"/>
                    <TextBlock x:Name="PlayerError" Visibility="Collapsed" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"/>
                </Grid>
            </Border>

            <!-- Timeline -->
            <player:TrimTimeline x:Name="Timeline" Grid.Row="2" Margin="16,14,16,0"/>

            <!-- Controls -->
            <Grid Grid.Row="3" Margin="16,8,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PlayBtn" Click="Play_Click" ToolTip="Play / pause (Space)" Width="44" Padding="0,7">
                        <TextBlock x:Name="PlayIcon" Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Button Click="StepBack_Click" ToolTip="Previous frame (←)" Margin="6,0,0,0" Padding="9,7">
                        <TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"/>
                    </Button>
                    <Button Click="StepFwd_Click" ToolTip="Next frame (→)" Margin="4,0,0,0" Padding="9,7">
                        <TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"/>
                    </Button>
                    <TextBlock x:Name="TimeText" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13" FontFamily="Segoe UI Variable Text, Segoe UI"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Set start  (I)" Click="SetIn_Click" Margin="0,0,6,0"/>
                    <Button Content="Set end  (O)" Click="SetOut_Click" Margin="0,0,6,0"/>
                    <ToggleButton x:Name="PreviewToggle" Style="{StaticResource Seg}" Content="Preview trim  (P)" Click="Preview_Click"
                                  Background="{StaticResource Card}" Padding="12,7" Margin="0,0,6,0"/>
                    <Button Content="Reset" Click="ResetTrim_Click" Style="{StaticResource GhostBtn}"/>
                    <TextBlock x:Name="TrimText" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12.5"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="MixPanel" Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,0">
                            <DockPanel Width="150">
                                <TextBlock x:Name="GameVolText" DockPanel.Dock="Right" Foreground="{StaticResource Subtle}" FontSize="11.5"/>
                                <TextBlock Text="Game + chat" FontSize="11.5" Foreground="{StaticResource Subtle}"/>
                            </DockPanel>
                            <Slider x:Name="GameVol" Minimum="-30" Maximum="20" Value="0" SmallChange="1" LargeChange="3"
                                    ValueChanged="Volume_ValueChanged" MouseDoubleClick="GameVol_DoubleClick" Width="150"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <DockPanel Width="150">
                                <TextBlock x:Name="MicVolText" DockPanel.Dock="Right" Foreground="{StaticResource Subtle}" FontSize="11.5"/>
                                <TextBlock Text="Your mic" FontSize="11.5" Foreground="{StaticResource Subtle}"/>
                            </DockPanel>
                            <Slider x:Name="MicVol" Minimum="-30" Maximum="20" Value="0" SmallChange="1" LargeChange="3"
                                    ValueChanged="Volume_ValueChanged" MouseDoubleClick="MicVol_DoubleClick" Width="150"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="ExportBtn" Style="{StaticResource AccentBtn}" Padding="14,8" Click="Export_Click"
                            ToolTip="Export the trimmed range as an MP4 under the Discord size limit (E)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Export for Discord" Margin="8,0,0,0" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Export panel (shown while exporting and afterwards) -->
            <Border x:Name="ExportPanel" Grid.Row="4" Visibility="Collapsed" Margin="16,0,16,16" Padding="14"
                    Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Drag source: a real OS file drag, drop it on a Discord chat -->
                    <Border x:Name="DragTile" Width="250" Padding="12,10" CornerRadius="8" Background="{StaticResource Card}"
                            BorderBrush="{StaticResource Accent}" BorderThickness="1" Cursor="Hand" Opacity="0.4"
                            PreviewMouseLeftButtonDown="DragTile_Down" PreviewMouseMove="DragTile_Move"
                            ToolTip="Drag this into a Discord chat">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource Accent}">
                                <TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="180">
                                <TextBlock Text="Drag into Discord" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock x:Name="ExportFileText" Foreground="{StaticResource Subtle}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock x:Name="ExportSizeText" DockPanel.Dock="Right" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="ExportStatus" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Border Height="6" CornerRadius="3" Background="{StaticResource Line}" Margin="0,8,0,0" ClipToBounds="True">
                            <Border x:Name="ExportBar" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="{StaticResource Accent}"/>
                        </Border>
                        <TextBlock x:Name="ExportDetail" Foreground="{StaticResource Subtle}" FontSize="11.5" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CopyFileBtn" Content="Copy file" Click="CopyFile_Click" Margin="0,0,6,0" IsEnabled="False"
                                ToolTip="Then press Ctrl+V in Discord"/>
                        <Button x:Name="OpenExportBtn" Content="Open folder" Click="OpenExport_Click" Margin="0,0,6,0" IsEnabled="False"/>
                        <Button x:Name="CancelExportBtn" Content="Cancel" Click="CancelExport_Click" Style="{StaticResource GhostBtn}"/>
                        <Button x:Name="CloseExportBtn" Click="CloseExport_Click" Style="{StaticResource GhostBtn}" Padding="8,6" Visibility="Collapsed">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
