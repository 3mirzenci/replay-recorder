<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev tool: runs the real Discord exporter from the command line for size tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputPath>$(MSBuildThisFileDirectory)bin\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ReplayRecorder.Core\ReplayRecorder.Core.csproj" />
  </ItemGroup>
</Project>
